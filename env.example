# Start in dry-run mode. Set to false only after OAuth, watchlist, and a manual test are done.
DRY_RUN=true
LOG_LEVEL=info
PORT=8080
GOOGLE_CLOUD_PROJECT=

# Local CLI OAuth fallback. Cloud Run should use Secret Manager below.
GOOGLE_OAUTH_CLIENT_PATH=./secrets/google-oauth-client.json
GMAIL_TOKEN_PATH=./data/google-token.json

# Secret Manager version names, e.g. projects/PROJECT/secrets/NAME
GMAIL_OAUTH_CLIENT_SECRET_NAME=
GMAIL_REFRESH_TOKEN_SECRET_NAME=
SPOHABI_PASSWORD_SECRET_NAME=
SPOHABI_API_KEY_SECRET_NAME=
SLACK_WEBHOOK_SECRET_NAME=
SLACK_WEBHOOK_URL=
INBOUND_EMAIL_HMAC_SECRET_NAME=
INBOUND_EMAIL_HMAC_SECRET=
INBOUND_EMAIL_MAX_AGE_SECONDS=300
INBOUND_EMAIL_EXPECTED_FROM=system@spohabi.com
TASK_SHARED_SECRET_NAME=
TASK_SHARED_SECRET=
GMAIL_API_ENABLED=true

# Gmail API. Google account password is never stored.
GMAIL_EXPECTED_EMAIL=
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/YOUR_TOPIC

# Google Calendar sync. Requires OAuth scope https://www.googleapis.com/auth/calendar.events.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_RECONCILE_DAYS=60
GOOGLE_CALENDAR_RECONCILE_SCHOOL_SLUG=fc-tennis

# Spohabi credentials and reservation profile.
SPOHABI_EMAIL=
SPOHABI_PASSWORD=
SPOHABI_LAST_NAME=
SPOHABI_FIRST_NAME=
SPOHABI_TEL=
SPOHABI_POSTAL_CODE=
SPOHABI_PREFECTURE=
SPOHABI_CITY=
SPOHABI_ADDRESS_LINE1=
SPOHABI_ADDRESS_LINE2=
SPOHABI_MEMBER_NOTE=

# Spohabi endpoints discovered from the public frontend. Override only if they change.
SPOHABI_GRAPHQL_ENDPOINT=https://fitting-jay-29.hasura.app/v1/graphql
SPOHABI_RESERVE_API_BASE=https://product-spohabi-tennis-api-cloud-run-275144620206.asia-northeast1.run.app
SPOHABI_API_KEY=
